                leaderboardSub: "৩টি টেস্ট ম্যাচের উপর ভিত্তি করে খেলোয়াড়দের র‍্যাঙ্কিং",
                thRank: "র‍্যাংক",
                thPlayer: "খেলোয়াড়ের নাম",
                thTest1: "টেস্ট ১",
                thTest2: "টেস্ট ২",
                thTest3: "টেস্ট ৩",
                thKills: "মোট কিল",
                thBooyah: "বুয়াহ",
                thTotal: "মোট পয়েন্ট",
                adminModalTitle: "অ্যাডমিন প্যানেল লগইন",
                adminModalSub: "শুধুমাত্র ফাইনাল গেমার লিডার/অফিসারের জন্য",
                adminPassLabel: "পাসওয়ার্ড লিখুন",
                loginBtn: "লগইন করুন",
                adminDashTitle: "ফাইনাল গেমার অ্যাডমিন ড্যাশবোর্ড",
                adminDashSub: "খেলোয়াড়দের স্কোর আপডেট করুন এবং নতুন খেলোয়াড় যোগ করুন",
                addNewPlayerBtn: "নতুন খেলোয়াড় যোগ করুন",
                thActions: "অ্যাকশন",
                editPlayerTitle: "খেলোয়াড়ের স্কোর সম্পাদনা",
                playerNameLabel: "খেলোয়াড়ের নাম (Free Fire IGN)",
                saveBtn: "ডেটা সংরক্ষণ করুন"
            }
        };

        let currentLang = 'hi';

        function setLanguage(lang) {
            currentLang = lang;
            ['en', 'hi', 'bn'].forEach(l => {
                const btn = document.getElementById(`lang-${l}`);
                if (btn) {
                    if (l === lang) {
                        btn.className = "px-3 py-1.5 text-xs font-bold rounded bg-red-600 text-white transition cursor-pointer";
                    } else {
                        btn.className = "px-3 py-1.5 text-xs font-bold rounded text-gray-400 hover:text-white transition cursor-pointer";
                    }
                }
            });

            const dict = translations[lang] || translations['hi'];
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (dict[key]) {
                    el.innerText = dict[key];
                }
            });
        }

        let guildPlayers = JSON.parse(localStorage.getItem('fg_guild_players')) || [];

        function savePlayersToStorage() {
            localStorage.setItem('fg_guild_players', JSON.stringify(guildPlayers));
        }

        function calculateTestPoints(t) {
            return (t.booyah * 12) + (t.kills * 1) + (t.rounds * 1);
        }

        function renderLeaderboard() {
            const tbody = document.getElementById('leaderboardTableBody');
            const searchQuery = document.getElementById('searchPlayerInput').value.toLowerCase();
            tbody.innerHTML = '';

            document.getElementById('totalPlayersCount').innerText = guildPlayers.length;

            if (guildPlayers.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" class="text-center py-8 text-gray-500 font-gaming">कोई खिलाड़ी नहीं मिला। कृपया एडमिन पैनल से खिलाड़ी जोड़ें।</td></tr>`;
                return;
            }

            const evaluatedPlayers = guildPlayers.map((p, idx) => {
                const p1 = calculateTestPoints(p.t1);
                const p2 = calculateTestPoints(p.t2);
                const p3 = calculateTestPoints(p.t3);
                const totalPts = p1 + p2 + p3;
                const totalK = p.t1.kills + p.t2.kills + p.t3.kills;
                const totalB = p.t1.booyah + p.t2.booyah + p.t3.booyah;
                return { ...p, originalIndex: idx, p1, p2, p3, totalPts, totalK, totalB };
            });

            evaluatedPlayers.sort((a, b) => b.totalPts - a.totalPts);

            evaluatedPlayers.forEach((p, rankIndex) => {
                const rank = rankIndex + 1;
                if (searchQuery && !p.name.toLowerCase().includes(searchQuery)) return;

                let rankBadge = `<span class="font-gaming font-bold text-gray-400">#${rank}</span>`;
                if (rank === 1) rankBadge = `<span class="px-2 py-0.5 rounded bg-yellow-500/20 text-yellow-400 font-gaming font-bold text-xs border border-yellow-500/40"><i class="fa-solid fa-crown mr-1"></i>#1</span>`;
                else if (rank === 2) rankBadge = `<span class="px-2 py-0.5 rounded bg-gray-300/20 text-gray-300 font-gaming font-bold text-xs border border-gray-400/40">#2</span>`;
                else if (rank === 3) rankBadge = `<span class="px-2 py-0.5 rounded bg-amber-700/20 text-amber-500 font-gaming font-bold text-xs border border-amber-600/40">#3</span>`;

                const row = document.createElement('tr');
                row.className = "hover:bg-white/5 transition border-b border-gray-800/40";
                row.innerHTML = `
                    <td class="py-3 px-4 text-center">${rankBadge}</td>
                    <td class="py-3 px-4 font-bold text-white">${p.name}</td>
                    <td class="py-3 px-4 text-center font-gaming text-gray-300">${p.p1} pts</td>
                    <td class="py-3 px-4 text-center font-gaming text-gray-300">${p.p2} pts</td>
                    <td class="py-3 px-4 text-center font-gaming text-gray-300">${p.p3} pts</td>
                    <td class="py-3 px-4 text-center text-red-400 font-bold">${p.totalK}</td>
                    <td class="py-3 px-4 text-center text-emerald-400 font-bold">${p.totalB}</td>
                    <td class="py-3 px-4 text-center font-gaming font-black text-yellow-400 text-sm">${p.totalPts}</td>
                `;
                tbody.appendChild(row);
            });
        }

        function openAdminPortal() {
            const loginModal = document.getElementById('adminLoginModal');
            if (loginModal) {
                loginModal.classList.remove('hidden');
            }
        }

        function handleAdminLogin(event) {
            event.preventDefault();
            const pwd = document.getElementById('adminPasswordInput').value.trim();
            if (pwd === "fgadmin123" || pwd === "FG@123") {
                toggleModal('adminLoginModal');
                renderAdminPlayerTable();
                toggleModal('adminDashboardModal');
                document.getElementById('adminPasswordInput').value = '';
            } else {
                alert("गलत पासवर्ड! डिफ़ॉल्ट पासवर्ड 'fgadmin123' है।");
            }
        }

        function renderAdminPlayerTable() {
            const tbody = document.getElementById('adminPlayerTableBody');
            tbody.innerHTML = '';

            if (guildPlayers.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="text-center py-6 text-gray-500">कोई खिलाड़ी नहीं है। ऊपर 'नया प्लेयर जोड़ें' पर क्लिक करें।</td></tr>`;
                return;
            }

            guildPlayers.forEach((p, idx) => {
                const row = document.createElement('tr');
                row.className = "hover:bg-white/5 transition border-b border-gray-800/40";
                row.innerHTML = `
                    <td class="py-3 px-3 font-bold text-white">${p.name}</td>
                    <td class="py-3 px-3 text-center text-gray-300">${p.t1.kills}k / ${p.t1.rounds}r / ${p.t1.booyah}b</td>
                    <td class="py-3 px-3 text-center text-gray-300">${p.t2.kills}k / ${p.t2.rounds}r / ${p.t2.booyah}b</td>
                    <td class="py-3 px-3 text-center text-gray-300">${p.t3.kills}k / ${p.t3.rounds}r / ${p.t3.booyah}b</td>
                    <td class="py-3 px-3 text-center space-x-2">
                        <button type="button" onclick="openEditPlayerModal(${idx})" class="px-2 py-1 bg-blue-600/20 text-blue-400 hover:bg-blue-600/40 rounded border border-blue-500/30 font-bold cursor-pointer"><i class="fa-solid fa-pen"></i></button>
                        <button type="button" onclick="deletePlayer(${idx})" class="px-2 py-1 bg-red-600/20 text-red-400 hover:bg-red-600/40 rounded border border-red-500/30 font-bold cursor-pointer"><i class="fa-solid fa-trash"></i></button>
                    </td>
                `;
                tbody.appendChild(row);
            });
        }

        function openAddPlayerModal() {
            document.getElementById('editPlayerIndex').value = "-1";
            document.getElementById('inputPlayerName').value = "";
            document.getElementById('inputPlayerUid').value = "";
            document.getElementById('t1_kills').value = "0";
            document.getElementById('t1_rounds').value = "0";
            document.getElementById('t1_booyah').value = "0";
            document.getElementById('t2_kills').value = "0";
            document.getElementById('t2_rounds').value = "0";
            document.getElementById('t2_booyah').value = "0";
            document.getElementById('t3_kills').value = "0";
            document.getElementById('t3_rounds').value = "0";
            document.getElementById('t3_booyah').value = "0";
            toggleModal('playerEditModal');
        }

        function openEditPlayerModal(idx) {
            const p = guildPlayers[idx];
            document.getElementById('editPlayerIndex').value = idx;
            document.getElementById('inputPlayerName').value = p.name;
            document.getElementById('inputPlayerUid').value = p.uid || "";
            document.getElementById('t1_kills').value = p.t1.kills;
            document.getElementById('t1_rounds').value = p.t1.rounds;
            document.getElementById('t1_booyah').value = p.t1.booyah;
            document.getElementById('t2_kills').value = p.t2.kills;
            document.getElementById('t2_rounds').value = p.t2.rounds;
            document.getElementById('t2_booyah').value = p.t2.booyah;
            document.getElementById('t3_kills').value = p.t3.kills;
            document.getElementById('t3_rounds').value = p.t3.rounds;
            document.getElementById('t3_booyah').value = p.t3.booyah;
            toggleModal('playerEditModal');
        }

        function handleSavePlayer(event) {
            event.preventDefault();
            const idx = parseInt(document.getElementById('editPlayerIndex').value);
            const name = document.getElementById('inputPlayerName').value.trim();
            const uid = document.getElementById('inputPlayerUid').value.trim();

            const playerData = {
                name: name,
                uid: uid || "N/A",
                t1: { kills: parseInt(document.getElementById('t1_kills').value) || 0, rounds: parseInt(document.getElementById('t1_rounds').value) || 0, booyah: parseInt(document.getElementById('t1_booyah').value) || 0 },
                t2: { kills: parseInt(document.getElementById('t2_kills').value) || 0, rounds: parseInt(document.getElementById('t2_rounds').value) || 0, booyah: parseInt(document.getElementById('t2_booyah').value) || 0 },
                t3: { kills: parseInt(document.getElementById('t3_kills').value) || 0, rounds: parseInt(document.getElementById('t3_rounds').value) || 0, booyah: parseInt(document.getElementById('t3_booyah').value) || 0 }
            };

            if (idx === -1) {
                guildPlayers.push(playerData);
            } else {
                guildPlayers[idx] = playerData;
            }

            savePlayersToStorage();
            toggleModal('playerEditModal');
            renderAdminPlayerTable();
            renderLeaderboard();
        }

        function deletePlayer(idx) {
            if (confirm("क्या आप वाकई इस खिलाड़ी को डिलीट करना चाहते हैं?")) {
                guildPlayers.splice(idx, 1);
                savePlayersToStorage();
                renderAdminPlayerTable();
                renderLeaderboard();
            }
        }

        function toggleModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) {
                modal.classList.toggle('hidden');
            }
        }

        function updateCountdown() {
            const now = new Date();
            const nextSunday = new Date();
            nextSunday.setDate(now.getDate() + (7 - now.getDay()) % 7);
            nextSunday.setHours(18, 0, 0, 0);

            if (now > nextSunday) {
                nextSunday.setDate(nextSunday.getDate() + 7);
            }

            const diff = nextSunday - now;
            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
            const minutes = Math.floor((diff / 1000 / 60) % 60);
            const seconds = Math.floor((diff / 1000) % 60);

            document.getElementById('days').innerText = String(days).padStart(2, '0');
            document.getElementById('hours').innerText = String(hours).padStart(2, '0');
            document.getElementById('minutes').innerText = String(minutes).padStart(2, '0');
            document.getElementById('seconds').innerText = String(seconds).padStart(2, '0');
        }

        setInterval(updateCountdown, 1000);

        window.onload = function() {
            setLanguage('hi');
            updateCountdown();
            renderLeaderboard();
        };
    </script>
</body>
</html>
```